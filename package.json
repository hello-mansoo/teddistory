{
  "name": "teddistory",
  "version": "1.3.0",
  "license": "MIT",
  "repository": "https://github.com/hello-mansoo/teddistory",
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "lodash-es": "4.18.1"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && next-sitemap --config next-sitemap.config.mjs",
    "start": "next start",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "test:e2e": "playwright test",
    "verify": "pnpm check && pnpm typecheck && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "mermaid": "12.0.0",
    "next": "16.3.5",
    "notion-client": "8.0.8",
    "notion-types": "8.0.8",
    "notion-utils": "8.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "react-notion-x": "8.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@biomejs/biome": "2.5.14",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "next-sitemap": "4.2.3",
    "typescript": "7.0.2"
  },
  "description": "teddy's tech blog",
  "main": "/pages/index.tsx",
  "author": "TwoShot22 <mansoo0621@naver.com>"
}
